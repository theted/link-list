# The shared postgres on the box is host `postgres` on the shared-services network
DATABASE_URL=postgresql://user:password@localhost:5432/linklist
# Leave empty when the server serves the app; http://localhost:8080 for `vite` dev
VITE_API_URL=http://localhost:8080
# Google OAuth client ID; the server verifies sign-ins against it too
VITE_AUTH_ID=auth_id
# Signs session tokens: openssl rand -hex 32
AUTH_SECRET=auth_secret
